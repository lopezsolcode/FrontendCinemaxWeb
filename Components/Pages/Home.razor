@inject IPeliculasService PeliculasService
@page "/"
@page "/Inicio"

<PageTitle>Inicio</PageTitle>

<div id="carouselExampleAutoplaying"
     class="carousel slide carousel-fade"
     data-bs-ride="carousel">

    <div class="carousel-inner">

        @if (peliculas == null)
        {
            <p>Cargando películas...</p>
        }
        else if (peliculas.Count == 0)
        {
            <p>No hay películas en cartelera.</p>
        }
        else
        {
            @for (int i = 0; i < peliculas.Count; i++)
            {
                var pelicula = peliculas[i];

                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@pelicula.PosterURL"
                         class="d-block w-100"
                         alt="@pelicula.Titulo">
                </div>
            }
        }

    </div>

    <button class="carousel-control-prev"
            type="button"
            data-bs-target="#carouselExampleAutoplaying"
            data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>

    <button class="carousel-control-next"
            type="button"
            data-bs-target="#carouselExampleAutoplaying"
            data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>
</div>

<h1>Hello, world!</h1>

Welcome to your new app.

@code {
    private List<PeliculaCarteleraDTO>? peliculas;

    protected override async Task OnInitializedAsync()
    {
        peliculas = await PeliculasService.GetPeliculasCarteleraAsync();
    }
}